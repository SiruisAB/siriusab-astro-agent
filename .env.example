# ===== 模型配置 =====
# 主档案（无后缀，三选一，去掉注释即可）；附加档案见下方"多模型档案"。

# --- OpenAI 官方 ---
MODEL_NAME=gpt-4o-mini
API_KEY=sk-你的key
# BASE_URL=
# API_TYPE=chat_completions       # chat_completions / responses / auto，默认 Chat

# --- DeepSeek ---
# MODEL_NAME=deepseek-chat
# API_KEY=你的key
# BASE_URL=https://api.deepseek.com/v1

# --- 智谱 GLM ---
# MODEL_NAME=glm-4-plus
# API_KEY=你的key
# BASE_URL=https://open.bigmodel.cn/api/paas/v4

# ===== 多模型档案（可选）：运行中 /model <名字> 热切换 =====
# 后缀任意（字母数字），档案名即后缀的小写。示例：
# MODEL_NAME_DEEPSEEK=deepseek-chat
# API_KEY_DEEPSEEK=你的key          # 缺省时沿用主档案的 API_KEY
# BASE_URL_DEEPSEEK=https://api.deepseek.com/v1
# API_TYPE_DEEPSEEK=chat_completions
#
# MODEL_NAME_GLM=glm-4-plus
# API_KEY_GLM=你的key
# BASE_URL_GLM=https://open.bigmodel.cn/api/paas/v4

# ===== NASA ADS 文献检索（可选，chat/research 模式查正式期刊论文用）=====
# 到 https://ui.adsabs.harvard.edu/user/settings/token 免费申请
# 不配置也能用：arXiv 检索（search_arxiv）无需任何 token
# ADS_TOKEN=你的token

# ===== chat 模式深度思考开关 =====
# 1（默认）= 两阶段生成：先内部草稿再输出，质量更高，但每问至少 2 次模型调用
# 0        = 单阶段直答：1~2 次调用，更快更省
# CHAT_TWO_STAGE=0

# ===== 上下文窗口（建议设置）=====
# 作用一：工作台显示上下文占用占比；作用二（必需）：SummarizationMiddleware 的
# fraction 触发器需要模型携带 max_input_tokens 元数据——langchain 只对注册表里的
# 知名模型自动补齐，自定义模型名（局域网后端、中转站别名等）必须在这里显式给出，
# 否则 agent/research/code/chat 四模式装配直接抛 ValueError。
# 按模型档案单独设置用 CONTEXT_WINDOW_<档案名大写>。
# CONTEXT_WINDOW=262144

# ===== 本地 Qwen coder390（专用单并发适配，自动按精确模型 ID 启用）=====
# MODEL_NAME_QWEN=qwen3.8-27b-coder390
# API_KEY_QWEN=local
# BASE_URL_QWEN=http://<your-qwen-host>:8088/v1
# API_TYPE_QWEN=chat_completions
# CONTEXT_WINDOW_QWEN=262144
# 图形界面可选择仅本轮 xhigh；默认 none，其他模型不受影响。
# 不会启动或停止外部推理服务；外部服务需自行保持运行。

# ===== 产物自动下载 =====
# 模型在沙箱里生成的文件会以公开 URL 回传（如 files.chat01.ai/python-generations/...）。
# 1（默认）= 回答后自动抓取这些链接并存到 results/artifacts/
# 0        = 不自动下载，只显示链接
# ARTIFACT_AUTO_FETCH=1

# ===== polyglot 投递 =====
# 1 = 把任意附件包成 PNG+原字节走图片通道送进对方沙箱（模型可用 python 解开）
# 0（默认）= 本地解包注入，内容进上下文
# 实测：该通道的图片附件会落到 /mnt/data/，模型自带 bash+python
# SANDBOX_MODE=1
