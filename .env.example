# ===== 模型配置 =====
# 主档案（无后缀，三选一，去掉注释即可）；附加档案见下方"多模型档案"。

# --- OpenAI 官方 ---
MODEL_NAME=gpt-4o-mini
API_KEY=sk-你的key
# BASE_URL=

# --- DeepSeek ---
# MODEL_NAME=deepseek-chat
# API_KEY=你的key
# BASE_URL=https://api.deepseek.com/v1

# --- 智谱 GLM ---
# MODEL_NAME=glm-4-plus
# API_KEY=你的key
# BASE_URL=https://open.bigmodel.cn/api/paas/v4

# ===== 多模型档案（可选）：运行中 /model <名字> 热切换 =====
# 后缀任意（字母数字），档案名即后缀的小写。示例：
# MODEL_NAME_DEEPSEEK=deepseek-chat
# API_KEY_DEEPSEEK=你的key          # 缺省时沿用主档案的 API_KEY
# BASE_URL_DEEPSEEK=https://api.deepseek.com/v1
#
# MODEL_NAME_GLM=glm-4-plus
# API_KEY_GLM=你的key
# BASE_URL_GLM=https://open.bigmodel.cn/api/paas/v4

# ===== NASA ADS 文献检索（可选，chat/research 模式查正式期刊论文用）=====
# 到 https://ui.adsabs.harvard.edu/user/settings/token 免费申请
# 不配置也能用：arXiv 检索（search_arxiv）无需任何 token
# ADS_TOKEN=你的token

# ===== chat 模式深度思考开关 =====
# 1（默认）= 两阶段生成：先内部草稿再输出，质量更高，但每问至少 2 次模型调用
# 0        = 单阶段直答：1~2 次调用，更快更省
# CHAT_TWO_STAGE=0
